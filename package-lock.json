{
  "name": "threadline2",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "threadline2",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@threadline2/api": {
      "resolved": "packages/api",
      "link": true
    },
    "node_modules/@threadline2/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/api": {
      "name": "@threadline2/api"
    },
    "packages/web": {
      "name": "@threadline2/web"
    }
  }
}
